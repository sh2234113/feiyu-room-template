{
  "name": "dsh-room-template",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "A public, sanitized DSH + SnowLuma room template: 3D room, garden, TV companion, QQ bridge. No private state or credentials.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/bridge.js",
    "test:room": "node scripts/test-room.mjs",
    "test:home": "node scripts/test-home.mjs",
    "test:garden": "node scripts/run-garden-tests.mjs",
    "test:garden:logic": "node scripts/run-garden-tests.mjs --logic-only",
    "test:mcp-servers": "node scripts/test-mcp-servers-stdio.mjs",
    "test:preset-prompt": "node scripts/test-preset-prompt.mjs",
    "test:role-card": "node scripts/test-role-card.mjs",
    "preview:home": "node scripts/home-preview.mjs",
    "shot:room": "node scripts/room-shot.mjs",
    "postinstall": "node scripts/patch-snowluma-sdk.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-host-apiproxy": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@snowluma/mcp": "^1.14.20",
    "@snowluma/sdk": "^1.14.20",
    "js-yaml": "^4.3.2",
    "zod": "^4.4.3"
  }
}
